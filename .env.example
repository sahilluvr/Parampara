# ─── REQUIRED ────────────────────────────────────────────────
# Anthropic Claude API (for AI features)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── OPTIONAL: Enable real auth ──────────────────────────────
# Google OAuth (for Google SSO)
# Get from: https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP (choose one)
# MSG91: https://msg91.com
MSG91_API_KEY=
MSG91_SENDER_ID=

# Twilio (alternative to MSG91)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── OPTIONAL: Payments ──────────────────────────────────────
# Stripe (for Pro plan billing)
# Get from: https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── OPTIONAL: Database (Phase 2) ────────────────────────────
# Supabase (replaces localStorage with real database)
# Get from: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── OPTIONAL: File Storage (Phase 2) ────────────────────────
# Cloudflare R2 (for media uploads)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=parampara-media

# ─── APP URL ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
