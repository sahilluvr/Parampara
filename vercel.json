{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/check-expirations",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/birthday-reminders",
      "schedule": "30 2 * * *"
    }
  ]
}